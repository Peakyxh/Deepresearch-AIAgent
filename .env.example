# ==================== LLM 提供者选择 ====================

# 全局 LLM 提供者：openai / deepseek / vllm / qwen
LLM_PROVIDER=deepseek

# Critic Agent 专用 LLM 提供者（避免同模型自审自导致偏执，留空则回退到 LLM_PROVIDER）
CRITIC_LLM_PROVIDER=qwen

# ==================== OpenAI ====================

OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ==================== DeepSeek ====================

DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ==================== vLLM ====================

VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3-8B

# ==================== Qwen（通义千问）====================

QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-flash

# ==================== 搜索引擎 ====================

# 搜索引擎提供者：tavily / serpapi / bing / bocha
SEARCH_PROVIDER=tavily

TAVILY_API_KEY=tvly-your-tavily-key
SERPAPI_API_KEY=your-serpapi-key
BING_API_KEY=your-bing-key
BOCHA_API_KEY=your-bocha-key

# ==================== 学术搜索 ====================

# 学术搜索提供者：arxiv / semantic_scholar / openalex
ACADEMIC_PROVIDER=arxiv

SEMANTIC_SCHOLAR_API_KEY=

# ==================== 会话（可选）====================

# 留空则每次运行自动生成新 ID（会话隔离），设固定值可复用历史
SESSION_ID=

# ==================== 评估系统 ====================

# 评估专用 LLM 提供者（留空则使用全局 LLM_PROVIDER）
EVALUATOR_LLM_PROVIDER=qwen

# Jina API 密钥（用于事实核查时抓取网页内容）
JINA_API_KEY=
