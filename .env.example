# ==================== LLM 提供者选择 ====================

# 全局 LLM 提供者：openai / deepseek / vllm / qwen
LLM_PROVIDER=deepseek

# Critic Agent 专用 LLM 提供者（避免同模型自审自导致偏执，留空则回退到 LLM_PROVIDER）
CRITIC_LLM_PROVIDER=qwen

# ==================== OpenAI ====================

OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ==================== DeepSeek ====================

DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ==================== vLLM ====================

VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3-8B

# ==================== Qwen（通义千问）====================

QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-flash

# ==================== 搜索引擎 ====================

# 搜索引擎提供者：tavily / serpapi / bing / bocha
SEARCH_PROVIDER=tavily

TAVILY_API_KEY=tvly-your-tavily-key
SERPAPI_API_KEY=your-serpapi-key
BING_API_KEY=your-bing-key
BOCHA_API_KEY=your-bocha-key

# ==================== 学术搜索 ====================

# 学术搜索提供者：arxiv / semantic_scholar / openalex
ACADEMIC_PROVIDER=arxiv

SEMANTIC_SCHOLAR_API_KEY=

# ==================== Critic 路由（可选）====================

# ≥80 直接进入 Writer；70-79 仅阻断性问题触发补研；最多补研 1 次
OVERALL_COHERENCE_PASS_THRESHOLD=80
OVERALL_COHERENCE_CONDITIONAL_THRESHOLD=70
CRITIQUE_MAX_RETRIES=1

# ==================== Token / 证据预算（可选）====================

MAX_WEB_SOURCES_PER_SUB_QUESTION=8
MAX_PAPER_SOURCES_PER_SUB_QUESTION=4
MAX_SOURCES_PER_DOMAIN=2
EVIDENCE_EXCERPT_CHARS=600
ORCHESTRATOR_DYNAMIC_ADJUST_MAX_ROUNDS=1
ORCHESTRATOR_DYNAMIC_ADJUST_MAX_NEW_PER_ROUND=1
ORCHESTRATOR_DYNAMIC_ADJUST_MAX_TOTAL_APPENDS=1
CLARIFIER_MAX_TOKENS=1200
PLANNER_MAX_TOKENS=3000
RESEARCHER_MAX_TOKENS=5000
CRITIC_MAX_TOKENS=2500
ORCHESTRATOR_MAX_TOKENS=1500
WRITER_OUTLINE_MAX_TOKENS=2000
WRITER_MAX_TOKENS=12000

# ==================== 会话（可选）====================

# 留空则每次运行自动生成新 ID（会话隔离），设固定值可复用历史
SESSION_ID=

# ==================== 评估系统 ====================

# 评估专用 LLM 提供者（留空则使用全局 LLM_PROVIDER）
EVALUATOR_LLM_PROVIDER=qwen

# Jina API 密钥（用于事实核查时抓取网页内容）
JINA_API_KEY=
